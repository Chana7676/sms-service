{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "FileName": "sms.db"
  },
  "FakeSmsProvider": {
    "ErrorRate": 0.1,
    "MinLatencyMs": 50,
    "MaxLatencyMs": 300
  },
  "SmsWorker": {
    "Enabled": true,
    "RetryIntervalMinutes": 1,
    "MaxAttempts": 3,
    "RetryBatchSize": 50
  }
}
